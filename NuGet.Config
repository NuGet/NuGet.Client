  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://data.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="dotnet-public">
      <package pattern="AwesomeAssertions" />
